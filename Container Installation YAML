services:
  steamos:
    # Remember to change 'PHOTOSBYAKIL' if your GitHub username is different
    image: ghcr.io/photosbyakil/truenas_steamos:main
    container_name: steamos-app
    network_mode: host
    environment:
      - PULSE_SERVER=unix:/tmp/pulseaudio.socket
    devices:
      - /dev/dri:/dev/dri 
      - /dev/input:/dev/input
      # Required for Sunshine to emulate your Moonlight controller inside Arch Linux
      - /dev/uinput:/dev/uinput
    volumes:
      - /mnt/storage/apps/steamos/home:/home/steam
    ipc: host
    privileged: true
    restart: unless-stopped
