services:
  steamos:
    # Built automatically from this repo: Arch Linux + Steam + Sunshine
    image: ghcr.io/photosbyakil/truenas_steamos:main
    network_mode: host
    environment:
      - PULSE_SERVER=unix:/tmp/pulseaudio.socket
      - TZ=America/New_York
    devices:
      - /dev/dri:/dev/dri
      - /dev/input:/dev/input
      # Required for Sunshine to emulate a Moonlight controller inside Arch Linux
      - /dev/uinput:/dev/uinput
    volumes:
      # Steam home + library lives here. Use a pool path that exists on your
      # TrueNAS (example uses HDD_1TB) and make sure it is writable.
      - /mnt/HDD_1TB/apps/steamos/home:/home/steam
      # Required so Xorg can attach Sunshine's virtual input devices (uinput)
      # to the display — without this, mouse/keyboard/gamepad won't reach Steam.
      - /run/udev:/run/udev:rw
    ipc: host
    privileged: true
    restart: unless-stopped

# ============================================================================
# NOTES FOR OTHER USERS
# ============================================================================
# IMPORTANT: Do NOT run this container alongside any OTHER Sunshine host
# (including Wolf / Games on Whales, or a second SteamOS instance) on the same
# machine. Sunshine and Wolf are both Moonlight streaming servers and claim the
# same ports (47984/47989 TCP and 47999/48010/48100/48200 UDP), so one of them
# will fail to start ("Address already in use").
#
#   - Run this box INSTEAD of Wolf, or
#   - Run it on a separate machine/NAS, or
#   - If you really must run both, stop Wolf (or change Sunshine's ports) first.
#
# Only one streaming host may own the Moonlight ports at a time.
#
# TROUBLESHOOTING: If the Sunshine web UI shows "CSRF Protection Error" when
# you set up your username/password, edit the config in your mounted volume at
# <volume>/home/.config/sunshine/sunshine.conf and set:
#     origin_web_ui_allowed = lan
#     csrf_allowed_origins = https://<your-nas-ip>:47990
# then Restart the app. NOTE: csrf_allowed_origins is comma-separated WITHOUT
# brackets (bracket form like ["https://..."] is parsed literally and never
# matches). The entrypoint normally seeds this automatically; only needed if
# your IP changed or the config was edited.

