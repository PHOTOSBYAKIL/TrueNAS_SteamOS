# TrueNAS_SteamOS — Container Installation
#
# The container auto-detects the GPU (AMD / Intel / NVIDIA) at boot and picks
# the matching drivers, Vulkan device and Sunshine encoder. Capture is always
# wlr-screencopy from the sway headless virtual output — no kernel params
# needed. Pick the compose template for your hardware below.

# ============================================================================
# TEMPLATE A — AMD & Intel
#
# Pass /dev/dri into the container. On AMD, the optional kernel parameter
# amdgpu.virtual_display keeps GPU rendering/DMA-BUFs clean (nice-to-have, not
# required — sway's headless output does not depend on it):
#   - AMD:   TrueNAS -> System -> Advanced -> Kernel Parameters:
#            amdgpu.virtual_display=0000:c5:00.0,1   (then reboot)
#            (use your GPU's PCI ID from `lspci`, or the generic `all,1`;
#             the old `desc:1920x1080` form creates ZERO crtcs and never worked)
#   - Intel: nothing needed for wlr capture.
# ============================================================================
services:
  steamos:
    image: ghcr.io/photosbyakil/truenas_steamos:main
    container_name: truenas-steamos
    network_mode: host
    privileged: true          # uinput, DRM master, gamescope direct render
    ipc: host                 # shared memory for Sunshine/gamescope frames
    shm_size: 2g
    devices:
      - /dev/dri:/dev/dri
      - /dev/input:/dev/input
      - /dev/uinput:/dev/uinput
      # VirtualHere USB controller passthrough (optional):
      # - /dev/bus/usb:/dev/bus/usb
      # - /dev/vhci:/dev/vhci
    environment:
      - TZ=America/New_York
      # - GAMESCOPE_RES=1920x1080
      # - GAMESCOPE_REFRESH=60
      # Microphone from the Moonlight client (e.g. a Mac running PulseAudio).
      - MIC_SERVER=192.168.86.42
      - AUDIO_MIC_ENABLED=true
      - AUDIO_NOISE_SUPPRESSION=true
      # - AUDIO_ECHO_CANCEL=false
      # VirtualHere USB server IP (controllers -> box): optional
      # - VH_SERVER=192.168.86.42
    ulimits:
      nofile: { soft: 1048576, hard: 1048576 }   # esync/fsync file handles
      memlock: { soft: -1, hard: -1 }
    volumes:
      # Steam home + library (use a fast SSD pool path on your TrueNAS)
      - /mnt/GAMING_1TB_SSD/apps/steamos/home:/home/steam
      # Lets gamescope attach Sunshine's virtual input devices (uinput)
      - /run/udev:/run/udev:rw
    restart: unless-stopped

# ============================================================================
# TEMPLATE B — NVIDIA (wlr capture + NVENC)
#
# NVIDIA uses wlr-screencopy capture from the sway output and NVENC encoding.
# You must use the NVIDIA Container Toolkit runtime and set nvidia-drm.modeset=1
# on the host. On TrueNAS this means deploying with the NVIDIA runtime reserved.
# ============================================================================
services:
  steamos:
    image: ghcr.io/photosbyakil/truenas_steamos:main
    container_name: truenas-steamos
    network_mode: host
    privileged: true
    ipc: host
    shm_size: 2g
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu, video, compute, utility]
    devices:
      - /dev/input:/dev/input
      - /dev/uinput:/dev/uinput
    environment:
      - TZ=America/New_York
      - NVIDIA_VISIBLE_DEVICES=all
      - NVIDIA_DRIVER_CAPABILITIES=all
      - MIC_SERVER=192.168.86.42
      - AUDIO_MIC_ENABLED=true
      - AUDIO_NOISE_SUPPRESSION=true
    ulimits:
      nofile: { soft: 1048576, hard: 1048576 }
      memlock: { soft: -1, hard: -1 }
    volumes:
      - /mnt/GAMING_1TB_SSD/apps/steamos/home:/home/steam
      - /run/udev:/run/udev:rw
    restart: unless-stopped

# ============================================================================
# NOTES
# ============================================================================
# IMPORTANT: Do NOT run this container alongside any OTHER Sunshine host
# (including Wolf / Games on Whales, or a second SteamOS instance) on the same
# machine. Sunshine and Wolf are both Moonlight streaming servers and claim the
# same ports (47984/47989 TCP and 47999/48010/48100/48200 UDP), so one of them
# will fail to start ("Address already in use"). Only one streaming host may
# own the Moonlight ports at a time.
#
# TROUBLESHOOTING: If the Sunshine web UI shows "CSRF Protection Error" when
# you set up your username/password, edit the config in your mounted volume at
# <volume>/home/.config/sunshine/sunshine.conf and set:
#     origin_web_ui_allowed = lan
#     csrf_allowed_origins = https://<your-nas-ip>:47990
# then Restart the app. NOTE: csrf_allowed_origins is comma-separated WITHOUT
# brackets (bracket form like ["https://..."] is parsed literally and never
# matches). The entrypoint normally seeds this automatically; only needed if
# your IP changed or the config was edited.
#
# RECOVERY: A frozen game is killed from Moonlight -> host app list ->
# "Close Game" / "Restart Steam" (or "Kill Steam" to stop the whole box).
