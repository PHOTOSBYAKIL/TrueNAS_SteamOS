# Minimal sway config for headless streaming.
# Games open on top of Steam BP naturally. Sunshine captures via wlr-screencopy.

output HEADLESS-1 mode 1920x1080@60Hz
seat seat0 hide_cursor 0
focus_follows_mouse no

default_border none
default_floating_border pixel 1

exec_always swayidle timeout 999999 '' before-sleep ''
