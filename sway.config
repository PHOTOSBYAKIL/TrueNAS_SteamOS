# Headless sway config for Sunshine streaming.
# Runs with WLR_BACKENDS=headless,libinput:
#   - headless creates a virtual compositor output (no physical monitor)
#   - libinput picks up Sunshine's uinput virtual input devices
# Requires host kernel param amdgpu.virtual_display=desc:1920x1080 so wlroots
# can match DRM + Vulkan devices (GPU rendering + DMA-BUFs for wlr-screencopy).

output HEADLESS-1 mode 1920x1080@60Hz

seat seat0 hide_cursor 0
focus_follows_mouse no

# Kiosk gaming box: every window (Steam, Proton games via XWayland) is
# fullscreen so games open ON TOP of Steam, never side by side.
for_window [app_id=".*"] fullscreen
for_window [class=".*"] fullscreen

# Prevent screen blanking during streaming
exec_always swayidle timeout 999999 '' before-sleep ''

# ============================================================================
# Recovery toolbar — close/restart a frozen fullscreen game from Moonlight.
# Sunshine's input is a uinput device -> libinput, so these bindsym work even
# when a crashed game covers the whole screen. The bar is 'overlay' mode so it
# stays visible on top of fullscreen windows; click its buttons or use hotkeys.
# Scripts live in $HOME/steamtools (seeded from the image on every boot).
# ============================================================================
bindsym Mod4+Ctrl+Shift+Q exec /home/steam/steamtools/close-game.sh
bindsym Mod4+Ctrl+Shift+R exec /home/steam/steamtools/restart-game.sh
bindsym Mod4+Ctrl+Shift+X exec /home/steam/steamtools/kill-steam.sh
bindsym Mod4+Ctrl+Shift+B bar mode toggle

bar {
    position bottom
    mode overlay
    status_command /home/steam/steamtools/toolbar-status.sh
    height 26
    font pango:DejaVu Sans Mono 11
    workspace_buttons no
    colors {
        background #101014E6
        statusline #c9d1d9
        focused_workspace  #1f6feb #1f6feb #ffffff
        active_workspace   #30363d #30363d #c9d1d9
        inactive_workspace #21262d #21262d #8b949e
    }
}
