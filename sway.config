# Headless sway config for Sunshine streaming.
# Runs with WLR_BACKENDS=headless,libinput:
#   - headless creates a virtual compositor output (no physical monitor)
#   - libinput picks up Sunshine's uinput virtual input devices
#
# gamescope runs NESTED on top of this sway session (WAYLAND_DISPLAY=wayland-1)
# and presents as a single fullscreen surface; Steam + games live inside it.
# The host kernel param amdgpu.virtual_display=0000:c5:00.0,1 keeps the GPU
# rendering + DMA-BUFs working for wlr-screencopy.

output HEADLESS-1 mode 1920x1080@60Hz

seat seat0 hide_cursor 0
focus_follows_mouse no

# Kiosk gaming box: the nested gamescope surface is always fullscreen so it
# fills the output and the recovery bar (layer top) hides behind it — it never
# covers the streamed content. Mod4+Ctrl+Shift+B un-fullscreens to reveal it.
for_window [app_id=".*"] fullscreen
for_window [class=".*"] fullscreen

# Prevent screen blanking during streaming
exec_always swayidle timeout 999999 '' before-sleep ''

# ============================================================================
# Recovery toolbar — close/restart a frozen game from Moonlight.
# Sunshine's input is a uinput device -> libinput, so the bindsym hotkeys work
# even when a crashed game covers the whole screen. The visible toolbar is
# Waybar (gtk-layer-shell): layer "top" + position "bottom", hidden behind the
# fullscreen gamescope surface. Press Mod4+Ctrl+Shift+B to reveal it.
# Scripts live in $HOME/steamtools (seeded from the image on every boot).
# ============================================================================
bindsym Mod4+Ctrl+Shift+Q exec /home/steam/steamtools/close-game.sh
bindsym Mod4+Ctrl+Shift+R exec /home/steam/steamtools/restart-game.sh
bindsym Mod4+Ctrl+Shift+X exec /home/steam/steamtools/kill-steam.sh
bindsym Mod4+Ctrl+Shift+B exec /home/steam/steamtools/reveal-bar.sh

exec_always waybar
