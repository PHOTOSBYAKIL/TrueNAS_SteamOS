# Headless sway config for Sunshine streaming.
# Runs with WLR_BACKENDS=headless,libinput:
#   - headless creates a virtual compositor output (no physical monitor)
#   - libinput picks up Sunshine's uinput virtual input devices
# Requires host kernel param amdgpu.virtual_display=desc:1920x1080 so wlroots
# can match DRM + Vulkan devices (GPU rendering + DMA-BUFs for wlr-screencopy).

output HEADLESS-1 mode 1920x1080@60Hz

seat seat0 hide_cursor 0
focus_follows_mouse no

# ============================================================================
# Kiosk layout — one app fills the screen, title bar always visible.
#
# Nothing is allowed to go compositor-fullscreen automatically: sway renders
# layer-top surfaces (the waybar title bar) BELOW fullscreen windows, so a
# fullscreen window would cover the window controls. Steam Big Picture asks
# for fullscreen at launch and Proton games usually do too, so both are
# explicitly kept out of fullscreen.
#
# Steam BP lives alone on workspace 1 (fills the output under the title bar).
# A launched game is moved to workspace 2 AND focused, so it comes to the
# foreground (otherwise it opens "behind" Steam — window on ws2 but focus and
# the stream stay on ws1). When the game closes, focus returns to Steam BP.
# Each workspace holds a single window (a second concurrent game would
# split workspace 2, which is a rare edge case). The title bar stays visible
# the whole time.
# ============================================================================
for_window [class="steam"] fullscreen disable
for_window [class="steam_app_.*"] fullscreen disable
for_window [class="steam_app_.*"] move container to workspace 2, focus

# Don't let Steam re-claim focus with a _NET_ACTIVE_WINDOW request right after
# a game maps — under the default "smart" policy that pulled focus back to
# workspace 1 and hid the game behind Big Picture.
focus_on_window_activation never

hide_edge_borders both

# No native sway title bars — the waybar top strip IS the title bar (focused
# window title + minimize/maximize/close buttons). Without this, sway's
# default "normal" border adds a second 30px title bar under the waybar.
default_border pixel 1
default_floating_border pixel 1
font pango:DejaVu Sans 11
titlebar_border_thickness 1
titlebar_padding 4 10 4 10

# Prevent screen blanking during streaming
exec_always swayidle timeout 999999 '' before-sleep ''

# ============================================================================
# Window controls + recovery hotkeys.
# The title bar (waybar/config.jsonc) exposes minimize / maximize / close as
# clickable buttons; these hotkeys give the same recovery actions even when the
# bar can't be reached (e.g. a maximized window covers it):
#   Q close focused app   R force-restart focused app   X kill Steam (stop box)
#   M restore minimized (scratchpad)                    B un-maximize + show bar
# ============================================================================
bindsym Mod4+Ctrl+Shift+Q exec /home/steam/steamtools/close-game.sh
bindsym Mod4+Ctrl+Shift+R exec /home/steam/steamtools/restart-game.sh
bindsym Mod4+Ctrl+Shift+X exec /home/steam/steamtools/kill-steam.sh
bindsym Mod4+Ctrl+Shift+M exec /home/steam/steamtools/minimize-restore.sh
bindsym Mod4+Ctrl+Shift+B exec /home/steam/steamtools/reveal-bar.sh

# Top title bar: focused window title + minimize / maximize / close buttons.
# Guarded so a `swaymsg reload` (which re-runs exec_always) can't stack a
# second bar — each reload added +30px of exclusive top space before.
exec_always sh -c 'pgrep -x waybar >/dev/null || exec waybar'
