{
    // Top title bar for the headless sway gaming box — replaces the old bottom
    // recovery toolbar. Nothing is ever compositor-fullscreen (the sway config
    // uses a tabbed workspace layout instead), so this layer-top bar is ALWAYS
    // visible and its window controls always work, even over running games.
    // Left: focused window title (live). Right: minimize / maximize / close.
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,
    "modules-left": ["sway/window", "custom/hidden"],
    "modules-center": [],
    "modules-right": ["custom/minimize", "custom/maximize", "custom/close"],

    "sway/window": {
        "format": "  {}",
        "max-length": 90,
        "tooltip": false
    },

    "custom/hidden": {
        // Shown only when the focused app is minimized (hidden in the sway
        // scratchpad) — click it (or [–]) to restore.
        "exec": "/home/steam/steamtools/hidden-indicator.sh",
        "interval": 2,
        "format": "{}",
        "on-click": "sh -c '/home/steam/steamtools/minimize-toggle.sh & disown'",
        "tooltip": false
    },

    "custom/minimize": {
        // Toggle: hide the focused app (scratchpad), or restore it if nothing
        // is focused (i.e. it was already minimized).
        "format": "  \u2013  ",
        "on-click": "sh -c '/home/steam/steamtools/minimize-toggle.sh & disown'",
        "tooltip": false
    },
    "custom/maximize": {
        // Fill the entire screen (compositor-fullscreen). The bar is hidden
        // while maximized; press the B hotkey to restore + show the bar.
        "format": "  \u25A2  ",
        "on-click": "sh -c 'SWAYSOCK=/run/user/1000/sway-ipc.sock XDG_RUNTIME_DIR=/run/user/1000 swaymsg fullscreen toggle'",
        "tooltip": false
    },
    "custom/close": {
        // Graceful close of the focused app, force-kill the game tree after 10s.
        "format": "  \u2715  ",
        "on-click": "sh -c 'sleep 0.1; /home/steam/steamtools/close-game.sh & disown'",
        "tooltip": false
    }
}
